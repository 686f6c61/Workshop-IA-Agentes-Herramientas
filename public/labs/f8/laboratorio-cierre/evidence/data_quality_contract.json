{
  "contract_id": "f8-final-data-quality-contract",
  "versión": "2026.06.07",
  "owner": "data-owner",
  "required_columns": [
    "case_id",
    "split",
    "segment",
    "language",
    "source",
    "trace_id",
    "has_required_fields",
    "label",
    "prediction",
    "decision",
    "latency_ms",
