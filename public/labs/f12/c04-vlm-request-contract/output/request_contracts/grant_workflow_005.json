        {
          "region_id": "alerta",
          "claim": "mensaje de bloqueo visible"
        },
        {
          "region_id": "boton",
          "claim": "botón de envío desactivado"
        },
        {
          "region_id": "estado_documento",
          "claim": "justificante pendiente"
        }
      ]
    }
  ],
  "non_visual_sources": [
    {
      "source_id": "policy",
      "path": "data/docs/grant_policy_excerpt.md",
