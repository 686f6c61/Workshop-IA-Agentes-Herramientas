    metrics: [
      { value: 'D={(xᵢ,yᵢ)}', label: 'supervisado: ejemplos con respuesta' },
      { value: 'D={xᵢ}', label: 'no supervisado: solo observaciones' },
      { value: 's,a,r,s′', label: 'refuerzo: estado, acción, recompensa, nuevo estado' },
      { value: 'baseline', label: 'comparador simple para saber si mejoras algo' },
    ],
    table: {
      headers: ['Familia', 'Señal de aprendizaje', 'Qué aprende', 'Ejemplo y cuidado'],
