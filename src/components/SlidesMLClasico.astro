      { value: 'Clasificación', label: 'y pertenece a un conjunto de clases: spam/no spam, A/B/C' },
      { value: 'Regresión', label: 'y es un número real: precio, demanda, latencia, riesgo' },
      { value: 'p(y = c | x)', label: 'probabilidad de clase dado un ejemplo x' },
      { value: 'ŷ = f(x)', label: 'valor predicho por una función aprendida' },
    ],
