  { label: 'scikit-learn - Clustering', href: 'https://scikit-learn.org/stable/modules/clustering.html' },
  { label: 'Sutton & Barto - Reinforcement Learning', href: 'https://incompleteideas.net/book/the-book-2nd.html' },
];

const slides = [
  {
    id: 'ml-clasico-mapa',
    number: 20,
    title: 'ML clásico: el mapa antes de los LLMs',
    icon: 'map',
    lead: 'Antes de hablar de modelos gigantes conviene separar tareas: aprender una etiqueta, predecir un número, descubrir estructura o actuar para maximizar recompensa. Esa separación evita elegir una arquitectura por moda cuando todavía no está claro qué señal de aprendizaje existe.',
    bigIdea: 'La pregunta no es “qué modelo uso”, sino “qué salida necesito, qué feedback tengo y cómo sabré que generaliza”.',
    metrics: [
      { value: 'x', label: 'entrada: features, texto, imagen, estado o señales' },
      { value: 'y', label: 'respuesta esperada, si existe' },
      { value: 'ŷ', label: 'predicción o decisión del modelo' },
      { value: 'L(y, ŷ)', label: 'pérdida: cuánto duele equivocarse' },
