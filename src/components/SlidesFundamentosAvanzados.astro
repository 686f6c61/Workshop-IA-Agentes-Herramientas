function enrichSlide(slide) {
  const extra = advancedExtrasById[slide.id] ?? {};
  return {
    ...slide,
    ...extra,
    teachingNotes: [...(slide.teachingNotes ?? []), ...(extra.teachingNotes ?? [])],
    formulaCards: [...(slide.formulaCards ?? []), ...(extra.formulaCards ?? [])],
    secondaryTables: [...(slide.secondaryTables ?? []), ...(extra.secondaryTables ?? [])],
    cards: [...(slide.cards ?? []), ...(extra.cards ?? [])],
    twoCols: [...(slide.twoCols ?? []), ...(extra.twoCols ?? [])],
    checklist: [...(slide.checklist ?? []), ...(extra.checklist ?? [])],
    steps: [...(slide.steps ?? []), ...(extra.steps ?? [])],
  };
}

