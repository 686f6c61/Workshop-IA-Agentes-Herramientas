  },
  {
    prefix: 'recap-ia-',
    lens: {
      theory: 'La IA clásica aporta los invariantes: estado, coste, restricción, plan, adversario y regla.',
      formula: 'Sistema fiable = generación + búsqueda/control + restricciones + evaluación.',
      example: 'Un agente moderno sin estos conceptos parece potente, pero falla justo al tocar producción.',
      decision: 'Usa este vocabulario para revisar cualquier arquitectura LLM antes de lanzarla.',
    },
  },
