const appliedLens = appliedLensById[id] ?? appliedLensByPrefix.find((item) => id.startsWith(item.prefix))?.lens;
const resolvedTeachingNotes = teachingNotes ?? teachingNotesById[id] ?? [];
---

<Slide id={id} number={number} title={title}>
  {lead && <p><i data-lucide={icon}></i> {lead}</p>}

  {resolvedTeachingNotes.length > 0 && (
    <div class="teaching-notes">
      {resolvedTeachingNotes.map((note) => <p>{note}</p>)}
    </div>
  )}

  {bigIdea && (
    <div class="big-idea">
      <p>{bigIdea}</p>
    </div>
  )}

  {appliedLens && (
    <div class="applied-lens">
      <div>
        <strong>Teoría aplicada</strong>
        <p>{appliedLens.theory}</p>
      </div>
      <div>
        <strong>Fórmula / criterio</strong>
        <p>{appliedLens.formula}</p>
      </div>
      <div>
        <strong>Ejemplo</strong>
        <p>{appliedLens.example}</p>
      </div>
      <div>
        <strong>Decisión</strong>
        <p>{appliedLens.decision}</p>
      </div>
    </div>
  )}

  {flow && (
    <div class="flow">
      {flow.map((step, index) => (
        <>
          <span class="flow-step">{step}</span>
          {index < flow.length - 1 && <span class="flow-arrow">&rarr;</span>}
        </>
      ))}
    </div>
  )}

  {metrics && (
    <div class="metric-strip">
      {metrics.map((metric) => (
        <div class="metric-card">
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </div>
      ))}
    </div>
  )}

  {formulaCards && (
    <div class="formula-card-grid">
      {formulaCards.map((item) => (
        <div class="formula-card">
          <strong>{item.title}</strong>
          <code set:html={item.formula} />
          <p>{item.explanation}</p>
          {item.example && <span>{item.example}</span>}
        </div>
      ))}
    </div>
  )}

  {caseStudy && (
    <div class="case-study">
      <p class="case-study-title"><i data-lucide="briefcase-business"></i> {caseStudy.title}</p>
      <p>{caseStudy.text}</p>
      {caseStudy.rows && (
        <div class="case-study-rows">
          {caseStudy.rows.map((row) => (
            <div>
              <strong>{row[0]}</strong>
              <span>{row[1]}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  )}

  {cards && (
    <div class="icon-grid">
      {cards.map((card) => (
        <div class="icon-card">
          <i data-lucide={card.icon ?? 'circle-dot'}></i>
          <div class="icon-card-content">
            <strong>{card.title}</strong>
            <p>{card.text}</p>
            {card.tag && <span class="tag">{card.tag}</span>}
          </div>
        </div>
      ))}
    </div>
  )}

  {twoCols && (
    <div class="two-cols">
      {twoCols.map((card) => (
        <div class="compare-card">
          <p class="compare-card-title"><i data-lucide={card.icon ?? 'columns-2'}></i> {card.title}</p>
          <p class="compare-card-desc">{card.text}</p>
          {card.tag && <span class="tag">{card.tag}</span>}
        </div>
      ))}
    </div>
  )}

  {table && (
    <table class="compact-table resource-table">
      <thead>
        <tr>
          {table.headers.map((header) => <th>{header}</th>)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            {row.map((cell) => <td set:html={cell} />)}
          </tr>
        ))}
      </tbody>
    </table>
  )}

  {secondaryTables && (
    <>
      {secondaryTables.map((secondaryTable) => (
        <table class="compact-table resource-table">
          <thead>
            <tr>
              {secondaryTable.headers.map((header) => <th>{header}</th>)}
            </tr>
          </thead>
          <tbody>
            {secondaryTable.rows.map((row) => (
              <tr>
                {row.map((cell) => <td set:html={cell} />)}
              </tr>
            ))}
          </tbody>
        </table>
      ))}
    </>
  )}

  {steps && (
    <ol class="steps">
      {steps.map((step) => <li>{step}</li>)}
    </ol>
  )}

  {checklist && (
    <div class="check-grid">
      {checklist.map((item) => (
        <div class="check-card">
          <strong>{item.label}</strong>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  )}

  {code && (
    <pre class="code-block"><code>{code}</code></pre>
  )}

  {callout && (
    <div class="callout">
      <p class="callout-title"><i data-lucide={callout.icon ?? 'lightbulb'}></i> {callout.title}</p>
      <p>{callout.text}</p>
    </div>
  )}

  {refs && (
    <div class="refs compact-refs">
      <p class="refs-title">Referencias</p>
      {refs.map((ref) => (
        <a href={ref.href} target="_blank" rel="noopener noreferrer">{ref.label}</a>
      ))}
    </div>
  )}
</Slide>
