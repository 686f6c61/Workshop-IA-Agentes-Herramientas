      <tr><td><strong>Qwen3-Max</strong></td><td>$1.20</td><td>$6</td><td>Frontier chino; EU/Intl. &lt;=32K tokens</td></tr>
      <tr><td><strong>Qwen Plus</strong></td><td>$0.40</td><td>$1.20-$4</td><td>Generalista barato; output cambia si usa thinking</td></tr>
      <tr><td><strong>DeepSeek V4 Pro</strong></td><td>$1.74 miss / $0.145 hit</td><td>$3.48</td><td>Modelo Pro 1M; thinking y non-thinking</td></tr>
      <tr><td><strong>DeepSeek V4 Flash</strong></td><td>$0.14 miss / $0.028 hit</td><td>$0.28</td><td>chat/reasoner apuntan a V4 Flash por compatibilidad</td></tr>
