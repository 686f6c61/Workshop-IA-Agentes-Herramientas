      <tr><td><strong>Claude Sonnet 4.6</strong></td><td>$3</td><td>$15</td><td>Estándar fuerte para agentes/código</td></tr>
      <tr><td><strong>GPT-5.5</strong></td><td>$5</td><td>$30</td><td>Premium OpenAI para trabajo profesional</td></tr>
