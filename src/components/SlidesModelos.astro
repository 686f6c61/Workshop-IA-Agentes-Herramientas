      <tr><td><strong>Scribble</strong></td><td>Dibujo a mano alzada</td><td>Convertir bocetos rápidos en imágenes detalladas</td></tr>
      <tr><td><strong>Tile</strong></td><td>Imagen a baja resolución</td><td>Upscaling con añadido de detalle inteligente</td></tr>
