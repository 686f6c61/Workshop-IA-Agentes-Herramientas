  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.slide'));
      const counter = document.getElementById('nav-counter');
      const progressTrack = document.getElementById('nav-progress');
      const progressBar = document.getElementById('progress-bar');
      const progressPreview = document.getElementById('nav-progress-preview');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const tocOverlay = document.getElementById('toc');
      const tocBtn = document.getElementById('toc-btn');
      const tocClose = document.getElementById('toc-close');
      const tocItems = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.toc-item, .toc-section-title'));
      const updateModal = document.getElementById('update-modal');
      const openUpdateBtn = document.getElementById('open-update-btn');
      const updateClose = document.getElementById('update-modal-close');
      const updateSeenKey = 'workshop-update-2026-05-22-advanced-engineering-seen';

      let current = 0;
      const total = slides.length;
      const numberedSlideNumbers = Array.from(slides)
        .map((slide) => slide.dataset.slideNumber)
        .filter((value) => value !== undefined && value !== '')
        .map((value) => Number(value));
      const lastSlideNumber = numberedSlideNumbers.length
        ? Math.max(...numberedSlideNumbers)
        : Math.max(total - 1, 0);
      const numberedSlides = Array.from(slides)
        .filter((slide) => slide.dataset.slideNumber)
        .sort((a, b) => Number(a.dataset.slideNumber) - Number(b.dataset.slideNumber));
      const slideByNumber = new Map(numberedSlides.map((slide) => [Number(slide.dataset.slideNumber), slide]));
      let numberBuffer = '';
      let numberTimer = null;

      function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
      }

      function getSlideTitle(slide) {
        const heading = slide.querySelector('h2, .section-heading');
        return heading?.textContent
          ?.replace(/^\s*\d+\s+/, '')
          .replace(/\s+/g, ' ')
          .trim() || 'Diapositiva';
      }

      function getSlideFromProgressEvent(e) {
        if (!progressTrack || numberedSlides.length === 0) return null;
        const rect = progressTrack.getBoundingClientRect();
        const ratio = clamp((e.clientX - rect.left) / rect.width, 0, 1);
        const index = clamp(Math.round(ratio * (numberedSlides.length - 1)), 0, numberedSlides.length - 1);
        return {
          slide: numberedSlides[index],
          number: Number(numberedSlides[index].dataset.slideNumber),
          ratio,
        };
      }

      function updateProgressPreview(e) {
        if (!progressTrack || !progressPreview) return;
        const target = getSlideFromProgressEvent(e);
        if (!target) return;
        const { slide, number, ratio } = target;
        progressPreview.querySelector('.nav-progress-preview-num').textContent = String(number);
        progressPreview.querySelector('.nav-progress-preview-title').textContent = getSlideTitle(slide);
        progressPreview.style.left = `${ratio * 100}%`;
        progressPreview.classList.add('visible');
        progressTrack.dataset.targetNumber = String(number);
        progressTrack.setAttribute('aria-valuetext', `${number}: ${getSlideTitle(slide)}`);
      }

      function hideProgressPreview() {
        progressPreview?.classList.remove('visible');
      }

      function showSlide(index) {
        if (index < 0 || index >= total) return;
        slides[current].classList.remove('active');
        current = index;
        slides[current].classList.add('active');
        slides[current].scrollTop = 0;
        updateUI();
        const id = slides[current].id;
        history.replaceState(null, '', `#${id}`);
      }

      function updateUI() {
        const slideNumber = slides[current].dataset.slideNumber;
        counter.textContent = slideNumber
          ? `${slideNumber} / ${lastSlideNumber}`
          : `${current === 0 ? 'Portada' : 'Cierre'} / ${lastSlideNumber}`;
        const progress = total > 1 ? (current / (total - 1)) * 100 : 0;
        progressBar.style.width = `${progress}%`;
        progressTrack?.setAttribute('aria-valuemax', String(lastSlideNumber));
        progressTrack?.setAttribute('aria-valuenow', slideNumber ? String(slideNumber) : current === 0 ? '1' : String(lastSlideNumber));
        progressTrack?.setAttribute('title', slideNumber ? `Slide ${slideNumber}: ${getSlideTitle(slides[current])}` : counter.textContent);
        prevBtn.disabled = current === 0;
        nextBtn.disabled = current === total - 1;
      }

      function next() { showSlide(current + 1); }
      function prev() { showSlide(current - 1); }

      function goToSlide(id) {
        const index = Array.from(slides).findIndex(s => s.id === id);
        if (index !== -1) {
          showSlide(index);
          closeToc();
        }
      }

      function goToSlideNumber(num) {
        if (num === 0) {
          showSlide(0);
          return;
        }

        const index = Array.from(slides).findIndex(s => Number(s.dataset.slideNumber) === num);
        if (index !== -1) showSlide(index);
      }

      function goToHashSlide() {
        const hash = window.location.hash.slice(1);
        if (!hash) return false;
        const index = Array.from(slides).findIndex(s => s.id === hash);
        if (index === -1) return false;
        if (index !== current) {
          slides[current].classList.remove('active');
          current = index;
          slides[current].classList.add('active');
          slides[current].scrollTop = 0;
          updateUI();
        }
        return true;
      }

      function openToc() { tocOverlay.classList.add('active'); }
      function closeToc() { tocOverlay.classList.remove('active'); }
      function openUpdateModal() {
        updateModal?.classList.add('active');
        updateModal?.setAttribute('aria-hidden', 'false');
      }
      function closeUpdateModal() {
        updateModal?.classList.remove('active');
        updateModal?.setAttribute('aria-hidden', 'true');
        try { sessionStorage.setItem(updateSeenKey, '1'); } catch {}
      }

      prevBtn.addEventListener('click', prev);
      nextBtn.addEventListener('click', next);
      tocBtn.addEventListener('click', openToc);
      tocClose.addEventListener('click', closeToc);
      openUpdateBtn?.addEventListener('click', openUpdateModal);
      updateClose?.addEventListener('click', closeUpdateModal);

      const kbdPrev = document.getElementById('kbd-prev');
      const kbdNext = document.getElementById('kbd-next');
      if (kbdPrev) kbdPrev.addEventListener('click', prev);
      if (kbdNext) kbdNext.addEventListener('click', next);

      progressTrack?.addEventListener('pointermove', updateProgressPreview);
      progressTrack?.addEventListener('pointerenter', updateProgressPreview);
      progressTrack?.addEventListener('pointerleave', hideProgressPreview);
      progressTrack?.addEventListener('click', (e) => {
        const target = getSlideFromProgressEvent(e);
        const previewNumber = progressPreview?.classList.contains('visible')
          ? Number(progressTrack.dataset.targetNumber)
          : NaN;
        if (Number.isFinite(previewNumber)) goToSlideNumber(previewNumber);
        else if (target) goToSlideNumber(target.number);
      });
      progressTrack?.addEventListener('keydown', (e) => {
        const currentNumber = Number(slides[current].dataset.slideNumber || 1);
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToSlideNumber(clamp(currentNumber + 10, 1, lastSlideNumber));
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlideNumber(clamp(currentNumber - 10, 1, lastSlideNumber));
        } else if (e.key === 'Home') {
          e.preventDefault();
          goToSlideNumber(1);
        } else if (e.key === 'End') {
          e.preventDefault();
          goToSlideNumber(lastSlideNumber);
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goToSlideNumber(currentNumber);
        }
      });

      tocOverlay.addEventListener('click', (e) => {
        if (e.target === tocOverlay) closeToc();
      });
      updateModal?.addEventListener('click', (e) => {
        if (e.target === updateModal) closeUpdateModal();
      });

      tocItems.forEach(item => {
        item.addEventListener('click', () => {
          const id = item.dataset.goto;
          if (id) goToSlide(id);
        });
      });

      window.addEventListener('hashchange', goToHashSlide);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (updateModal?.classList.contains('active')) closeUpdateModal();
          closeToc();
          return;
        }
        if (tocOverlay.classList.contains('active') || updateModal?.classList.contains('active')) return;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
          e.preventDefault(); next();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault(); prev();
        } else if (e.key === 'Home') {
          e.preventDefault(); showSlide(0);
        } else if (e.key === 'End') {
          e.preventDefault(); showSlide(total - 1);
        } else if (e.key >= '0' && e.key <= '9') {
          numberBuffer += e.key;
          clearTimeout(numberTimer);
          numberTimer = setTimeout(() => {
            const num = parseInt(numberBuffer, 10);
            if (num >= 0 && num <= lastSlideNumber) goToSlideNumber(num);
            numberBuffer = '';
          }, 500);
        }
      });

      // Touch/swipe support
      let touchStartX = 0;
      let touchStartY = 0;

      document.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
          if (deltaX < 0) next(); else prev();
        }
      }, { passive: true });

      // Initial slide from hash
      const hash = window.location.hash.slice(1);
      if (hash) goToHashSlide();
      slides[current].classList.add('active');
      updateUI();
      const shouldShowUpdate = !hash || hash === 'cover';
      try {
        if (shouldShowUpdate && sessionStorage.getItem(updateSeenKey) !== '1') openUpdateModal();
      } catch {
        if (shouldShowUpdate) openUpdateModal();
      }
    });
  </script>
</Layout>
