<Layout title="Workshop de IA para gente curiosa - by 686f6c61">
  <!-- TABLE OF CONTENTS OVERLAY -->
  <div class="toc-overlay" id="toc">
    <div class="toc-content">
      <div class="toc-header">
        <h2>Índice</h2>
        <button class="toc-close" id="toc-close" aria-label="Cerrar índice">&times;</button>
      </div>
      {tocSections.map((section) => (
        <div class="toc-section">
          <button class="toc-section-title" data-goto={section.sectionSlide}>{section.title}</button>
          {section.items.map((item) => (
            <button class="toc-item" data-goto={item.id}>
              <span class="toc-num">{String(item.num).padStart(2, '0')}</span>
              {item.label}
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- UPDATE MODAL -->
  <div class="update-modal" id="update-modal" aria-hidden="true">
    <div class="update-modal-panel" role="dialog" aria-modal="true" aria-labelledby="update-modal-title">
      <div class="update-modal-header">
        <div>
          <p class="update-modal-eyebrow">Actualización del día · 17 mayo 2026</p>
          <h2 id="update-modal-title">Nuevos contenidos añadidos</h2>
        </div>
        <button class="update-modal-close" id="update-modal-close" type="button" aria-label="Cerrar novedades">&times;</button>
      </div>
      <div class="update-modal-body">
        <p class="update-modal-lead">Resumen de la actualización: más fundamentos clásicos, práctica con datos, agentes, evaluación, operación y criterio de producto.</p>
        <div class="update-grid">
          <div class="update-card">
            <strong>IA clásica aplicada</strong>
            <p>Búsqueda, SAT/CSP, planificación, juegos, ontologías, SPARQL y sistemas expertos conectados con agentes modernos.</p>
          </div>
          <div class="update-card">
            <strong>ML clásico y laboratorios</strong>
            <p>Supervisado, regresión, validación, matriz de confusión, precision/recall/F1, k-means y labs con scikit-learn.</p>
          </div>
          <div class="update-card">
            <strong>Modelos y Hugging Face</strong>
            <p>Arquitecturas, MoE, quantización, formatos, VRAM, model cards, embeddings, benchmarks y estado del arte.</p>
          </div>
          <div class="update-card">
            <strong>Agentes y producción</strong>
            <p>Tools, MCP, Harness Engineering, evals, observabilidad, seguridad, despliegue, costes, rate limits y patrones reales de ingeniería.</p>
